<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/lyrics_search_exit_interpolator"
    android:shareInterpolator="true">
    <translate
        android:duration="@integer/lyrics_search_exit_duration"
        android:fromXDelta="0"
        android:toXDelta="@fraction/lyrics_search_retreat_offset" />
    <scale
        android:duration="@integer/lyrics_search_exit_duration"
        android:fromXScale="1"
        android:fromYScale="1"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="0.99"
        android:toYScale="0.99" />
</set>
