<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/lyrics_search_enter_interpolator"
    android:shareInterpolator="true">
    <translate
        android:duration="@integer/lyrics_search_enter_duration"
        android:fromXDelta="@fraction/lyrics_search_retreat_offset"
        android:toXDelta="0" />
    <scale
        android:duration="@integer/lyrics_search_enter_duration"
        android:fromXScale="0.99"
        android:fromYScale="0.99"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
